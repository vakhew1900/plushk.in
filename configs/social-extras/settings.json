{
  "version": 2,
  "exportedAt": "2026-07-24T00:00:00.000Z",
  "rules": [
    {
      "id": "test-social-reddit-programming",
      "name": "Reddit — r/programming",
      "desc": "Матчит по extras.subreddit, который заполняется через PageMatchGroup 'pmg-reddit'. Пока не сработает на живых закладках: PageExtractorService/content script ещё не подключены к background.ts (см. RULE-5 в specs/backlog.md) — extras сейчас никогда не заполняется в реальном flow создания закладки.",
      "condition": {
        "type": "and",
        "nodes": [
          { "type": "terms", "field": "domain", "values": ["reddit.com", "www.reddit.com", "old.reddit.com"] },
          { "type": "term", "field": "subreddit", "value": "programming" }
        ]
      },
      "targetFolder": "Social/Reddit/Programming",
      "priority": 20,
      "enabled": true
    },
    {
      "id": "test-social-dtf-games",
      "name": "DTF — хаб Игры",
      "desc": "Матчит по extras.hub, который заполняется через PageMatchGroup 'pmg-dtf'. Тот же статус, что и у reddit-правила выше — ждёт RULE-5.",
      "condition": {
        "type": "and",
        "nodes": [
          { "type": "term", "field": "domain", "value": "dtf.ru" },
          { "type": "term", "field": "hub", "value": "Игры" }
        ]
      },
      "targetFolder": "Social/DTF/Игры",
      "priority": 10,
      "enabled": true
    }
  ],
  "domainAliases": [
    {
      "id": "test-alias-reddit",
      "name": "Reddit",
      "domain_names": ["reddit.com", "www.reddit.com", "old.reddit.com"]
    },
    {
      "id": "test-alias-dtf",
      "name": "DTF",
      "domain_names": ["dtf.ru"]
    }
  ],
  "pageMatchGroups": [
    {
      "id": "pmg-reddit",
      "alias_name": "Reddit — subreddit",
      "pageMatches": {
        "subreddit": {
          "name": "subreddit",
          "selector": { "type": "css", "value": "h1.redditname a" }
        }
      }
    },
    {
      "id": "pmg-dtf",
      "alias_name": "DTF — хаб",
      "pageMatches": {
        "hub": {
          "name": "hub",
          "selector": { "type": "css", "value": ".content-header__topic" }
        }
      }
    }
  ]
}
