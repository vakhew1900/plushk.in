{
  "version": 2,
  "exportedAt": "2026-07-24T00:00:00.000Z",
  "rules": [
    {
      "id": "test-mail-gmail",
      "name": "Почта — Gmail",
      "desc": "Только домен, без фильтрации по заголовку.",
      "condition": {
        "type": "terms",
        "field": "domain",
        "values": ["gmail.com", "mail.google.com"]
      },
      "targetFolder": "Mail/Gmail",
      "priority": 40,
      "enabled": true
    },
    {
      "id": "test-mail-mailru",
      "name": "Почта — Mail.ru",
      "desc": "Только домен, без фильтрации по заголовку.",
