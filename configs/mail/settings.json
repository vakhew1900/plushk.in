        "type": "terms",
        "field": "domain",
        "values": ["mail.ru", "e.mail.ru"]
      },
      "targetFolder": "Mail/Mail.ru",
      "priority": 30,
      "enabled": true
    },
    {
      "id": "test-mail-yandex",
      "name": "Почта — Yandex",
      "desc": "Только домен, без фильтрации по заголовку.",
      "condition": {
        "type": "terms",
        "field": "domain",
        "values": ["yandex.ru", "mail.yandex.ru", "ya.ru"]
